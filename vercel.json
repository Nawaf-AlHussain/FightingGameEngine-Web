{
  "headers": [
    {
      "source": "/game/(.*)\\.wasm$",
      "headers": [
        { "key": "Content-Type", "value": "application/wasm" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/game/ikemen-fs/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/game/(.*)\\.(js|json)$",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
