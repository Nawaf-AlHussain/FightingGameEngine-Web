paletteselect = 3
; Enables or disables palette selection menu in select screen. Accepted values:
; 0 - Palette menu disabled. Palette corresponds to key pressed when selecting character
; 1 - Palette menu enabled. Initial selected palette is 1
; 2 - Palette menu enabled. Initial selected palette corresponds to key pressed (a = 1, b = 2, etc)
; 3 - Palette menu enabled. Initial selected palette corresponds to key pressed + keymap (a = 4, x = 1, etc for Kung Fu Man)

p1.palmenu.pos = 220, 140
