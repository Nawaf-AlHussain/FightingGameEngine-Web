			if getCommandLineValue("-nojoy") == nil then
				options.f_keyCfgInit('Joystick', t.submenu[t.items[item].itemname].title)
				while true do
					if not options.f_keyCfg('Joystick', t.items[item].itemname, motif.optionbgdef, false) then
